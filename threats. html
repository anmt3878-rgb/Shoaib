<script>

function showToast(message){

    const toast=document.getElementById("toast");

    toast.textContent=message;

    toast.classList.add("show");

    setTimeout(function(){

        toast.classList.remove("show");

    },2500);

}


function viewThreat(id){

    showToast(
        "Threat " + id + " selected — Demo details coming next."
    );

}


function filterThreats(){

    const selected =
        document.getElementById("severityFilter").value;

    const rows =
        document.querySelectorAll("#threatTable tbody tr");

    rows.forEach(function(row){

        const severity =
            row.getAttribute("data-severity");

        if(selected === "all" || severity === selected){

            row.style.display="table-row";

        }else{

            row.style.display="none";

        }

    });

}


function searchThreats(value){

    const search =
        value.toLowerCase();

    const rows =
        document.querySelectorAll("#threatTable tbody tr");

    rows.forEach(function(row){

        const text =
            row.innerText.toLowerCase();

        if(text.includes(search)){

            row.style.display="table-row";

        }else{

            row.style.display="none";

        }

    });

}

</script>

